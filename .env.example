# Copy this file to .env and fill in YOUR keys. .env is gitignored — never commit it.
# In the deployed app, users paste their own keys in the UI (session-only); .env is for local dev only.

# Required. Create at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional (vision, Critic, fallback). Create at https://openrouter.ai/settings/keys
# Also enable free models in https://openrouter.ai/settings/privacy
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Optional, owner only: Hugging Face write token for pushing to the Space.
# In CI it is the GitHub Actions secret HF_TOKEN. https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_key_here
